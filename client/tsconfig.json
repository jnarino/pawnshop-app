{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2020"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "baseUrl": "./src",
    "types": ["node"],
    "paths": {
      "@/*": ["*"],
      "app/*": ["app/*"],
      "core/*": ["app/core/*"],
      "feature/*": ["app/feature/*"],
      "shared/*": ["app/shared/*"]
    }
  },
  "include": ["./src","./electron"],
  "exclude": ["dist", "node_modules"],
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      }
  }
}