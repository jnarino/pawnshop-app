# ============================================
# PAWNSHOP APP - CLIENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# API CONFIGURATION
# ============================================
# Base URL for the backend API server (without port)
# Development: http://localhost
# Production: Update with your production API URL
VITE_API_BASE_URL=http://localhost

# Backend API port
VITE_API_PORT=3001

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# Frontend host (without port)
VITE_FRONTEND_HOST=http://localhost

# Frontend port (Vite dev server)
VITE_FRONTEND_PORT=5173

# ============================================
# STORE INFORMATION
# ============================================
# These values appear on printed forms and receipts
VITE_STORE_NAME="LARRY'S ESTATE JEWELRY & PAWN"
VITE_STORE_ADDRESS1="3316 CLEVELAND AVE."
VITE_STORE_ADDRESS2="FORT MYERS, FL 33901"
VITE_STORE_PHONE="(239) 399-3633"

# ============================================
# APPLICATION SETTINGS
# ============================================
# Maximum number of customer records to return in search results
VITE_CUSTOMER_SEARCH_LIMIT=100
