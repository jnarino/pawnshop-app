# Development Database Configuration
NODE_ENV=development
PORT=3001
DB_PORT=54330

# SQL Server (Development)
# Note: These keys are REQUIRED by the Migration Tool (to read legacy data).
# They are NOT used by the Node.js Backend API.SQLSERVER_HOST=localhost
SQLSERVER_PORT=14330
SQLSERVER_DB=PawnMaster_v2
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrong!Passw0rd

# PostgreSQL (Development)
# Note: Docker migration script injects host.docker.internal for internal connectivity
POSTGRES_HOST=localhost
POSTGRES_PORT=54330
POSTGRES_DB=pawnshop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Docker Configuration
CONTAINER_NAME_SQL=pawnshop_sqlserver_prod
CONTAINER_NAME_PG=pawnshop_postgres_prod
DOCKER_NETWORK=pawnshop-app_default