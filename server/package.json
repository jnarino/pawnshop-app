{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean": "powershell -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }\"",
    "test": "node -r ts-node/register src/tests/testHarness.ts",
    "test:routes": "node -r ts-node/register src/tests/route/customerRoute.test.ts",
    "test:watch": "nodemon -e ts --exec npm run test",
    "test:coverage": "nyc npm run test",
    "test:ci": "npm test -- --ci --coverage --maxWorkers=2",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start:dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "postbuild": "powershell -Command \"robocopy src\\infrastructure\\db\\migrations dist\\infrastructure\\db\\migrations *.sql /S > $null; robocopy src\\infrastructure\\db\\command dist\\infrastructure\\db\\command *.sql /S > $null; robocopy src\\infrastructure\\db\\query dist\\infrastructure\\db\\query *.sql /S > $null; exit 0\"",
    "start:prod": "node dist/server.js",
    "db:migrate": "ts-node src/infrastructure/db/migrations/runMigrations.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "argon2": "^0.31.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jest": "^30.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "redis": "^4.6.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.2.0",
    "@types/redis": "^4.0.11",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.0.0",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
